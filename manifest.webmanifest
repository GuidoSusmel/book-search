{
  "name": "GASStudio Book Search",
  "short_name": "Book Search",
  "description": "Buscá libros libres por título, autor o foto de la tapa y descargalos en PDF, gratis y sin registrarte.",
  "lang": "es-AR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["books", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Buscar por foto de la tapa", "url": "./#foto", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
